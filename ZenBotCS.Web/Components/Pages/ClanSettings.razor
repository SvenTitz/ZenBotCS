@page "/clans/{ClanTag}/settings"
@using System.Security.Claims
@using ZenBotCS.Entities
@using ClanSettingsEntity = ZenBotCS.Entities.Models.ClanSettings
@inject ClanSettingsService Settings
@inject SubRosterService SubRosters
@inject DiscordGuildService Guild
@inject ClanNameService ClanNames
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<ClanSettings> Logger

<PageTitle>Clan settings</PageTitle>

<AuthorizeView Roles="@AuthRoles.Gatekeeper" Context="auth">
    <NotAuthorized>
        <ClanTabs ClanTag="@ClanTag" Active="settings" />
        <AccessDenied What="clan settings (gatekeepers only)" Authenticated="auth.User.Identity?.IsAuthenticated == true" />
    </NotAuthorized>
    <Authorized>
        <ClanTabs ClanTag="@ClanTag" Active="settings" />

        @if (_settings is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">Settings</MudText>
                <MudSpacer />
                <MudTooltip Text="Re-fetch roles &amp; channels from Discord">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                   OnClick="RefreshGuild" Disabled="_refreshing" aria-label="Refresh roles and channels" />
                </MudTooltip>
            </MudStack>

            @if (!_guildLoaded)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    Couldn't load roles/channels from Discord — check the bot token and guild id in config.
                    You can still edit everything else; role/channel pickers will be empty.
                </MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">General</MudText>

                        <MudSelect T="ClanType" @bind-Value="_settings.ClanType" Label="Clan type"
                                   HelperText="Event and partner clans have no roster of their own — they host a war clan's roster instead."
                                   Error="@(TypeError is not null)" ErrorText="@TypeError"
                                   Dense="true" Class="mb-3">
                            @foreach (var t in Enum.GetValues<ClanType>())
                            {
                                <MudSelectItem Value="t">@t</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="int" @bind-Value="_settings.Order" Label="Sort order"
                                         HelperText="Position within its type in the clan list (lower first)."
                                         Min="0" Class="mb-3" />

                        <MudTextField T="string" @bind-Value="_settings.ColorHex" Label="Embed colour (hex)"
                                      Placeholder="#RRGGBB or #RRGGBBAA" Immediate="true"
                                      Error="@(!ClanSettingsService.IsValidColorHex(_settings.ColorHex))"
                                      ErrorText="Use #RRGGBB or #RRGGBBAA."
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Palette"
                                      Class="mb-1" />
                        @if (ClanSettingsService.IsValidColorHex(_settings.ColorHex) && !string.IsNullOrWhiteSpace(_settings.ColorHex))
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <span style="@Swatch(_settings.ColorHex)"></span>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Preview</MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Roles</MudText>
                        @RoleSelect("Member role", _settings.MemberRoleId, v => _settings.MemberRoleId = v)
                        @RoleSelect("Elder role", _settings.ElderRoleId, v => _settings.ElderRoleId = v)
                        @RoleSelect("Leader role", _settings.LeaderRoleId, v => _settings.LeaderRoleId = v)
                        @RoleSelect("CWL role", _settings.CwlRoleId, v => _settings.CwlRoleId = v)
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">CWL &amp; features</MudText>
                        <MudSwitch T="bool" @bind-Value="_settings.EnableCwlSignup" Color="Color.Primary"
                                   Label="Enable CWL signup" Class="d-block" />
                        <MudSwitch T="bool" @bind-Value="_settings.ChampStyleCwlRoster" Color="Color.Primary"
                                   Label="Champ-style CWL roster" Class="d-block" />
                        <MudSwitch T="bool" @bind-Value="_settings.CcGoldDump" Color="Color.Primary"
                                   Label="Clan Capital gold dump clan" Class="d-block" />

                        @if (RosterTabs.HasRoster(_settings.ClanType))
                        {
                            <div class="mt-3">
                                <MudText Typo="Typo.caption" Class="d-block">Main roster war size</MudText>
                                <MudToggleGroup T="int" @bind-Value="_settings.CwlRosterTargetSize"
                                                Size="Size.Small" Color="Color.Primary">
                                    <MudToggleItem Value="15">15v15</MudToggleItem>
                                    <MudToggleItem Value="30">30v30</MudToggleItem>
                                </MudToggleGroup>
                                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mt-1">
                                    Extra rosters carry their own size, set on the roster page.
                                </MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Rosters</MudText>

                        @if (_hostedRoster is not null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                @_hostedRoster.Name (@WarSize(_hostedRoster.TargetSize)) belongs to
                                <b>@_hostedOwnerName</b> and plays its CWL here. Its players are managed on
                                <MudLink Href="@RosterHref(_hostedRoster.ClanTag, _hostedRoster.Id)">that clan's roster page</MudLink>.
                            </MudAlert>
                        }

                        @if (RosterTabs.HasRoster(_settings.ClanType))
                        {
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                <MudText Typo="Typo.body2">
                                    Main roster — plays here (@WarSize(_settings.CwlRosterTargetSize))
                                </MudText>
                            </div>
                            @foreach (var sr in _ownRosters)
                            {
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">
                                        @sr.Name — plays in @HostName(sr.GameClanTag) (@WarSize(sr.TargetSize))
                                    </MudText>
                                </div>
                            }
                            <MudButton Href="@RosterHref(ClanTag, null)" StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Variant="Variant.Text" Size="Size.Small" Class="mt-2">
                                Manage on the roster page
                            </MudButton>
                        }
                        else if (_hostedRoster is null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                No roster plays here yet. A war clan can split its CWL signups into a roster
                                hosted by this clan, created from that clan's roster page.
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Leadership reminders</MudText>
                        @ChannelSelect("Leadership channel", _settings.LeadershipChannelId,
                            v => _settings.LeadershipChannelId = v)
                        <MudSwitch T="bool" @bind-Value="_settings.CwlRosterReminderEnabled" Color="Color.Primary"
                                   Label="Send CWL roster reminder" Class="d-block" />
                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-2">
                            One reminder per roster — the clan's own plus every roster it plays in another
                            clan — all posted to the channel above.
                        </MudText>
                        @RoleSelect("CWL roster ping role", _settings.CwlRosterReminderPingRoleId,
                            v => _settings.CwlRosterReminderPingRoleId = v)
                        <MudNumericField T="int" @bind-Value="_settings.CwlRosterReminderLeadHours"
                                         Label="Lead time (hours before war day)" Min="0" Max="168" Class="mt-3" />
                        <MudSwitch T="bool" @bind-Value="_settings.WarSpinReminderEnabled" Color="Color.Primary"
                                   Label="Send war spin reminder" Class="d-block mt-3" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Disabled="@(_saving || TypeError is not null || !ClanSettingsService.IsValidColorHex(_settings.ColorHex))">
                    @(_saving ? "Saving…" : "Save settings")
                </MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.RestartAlt"
                           OnClick="ResetAsync" Disabled="@(_saving || !_exists)">
                    Reset to defaults
                </MudButton>
            </MudStack>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public string ClanTag { get; set; } = string.Empty;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ClanSettingsEntity? _settings;
    private bool _exists;
    private string _clanName = string.Empty;
    private string _actor = "unknown"; // "username (discordId)" of the signed-in gatekeeper, for the audit log
    private bool _saving;
    private bool _refreshing;

    private List<SubRoster> _ownRosters = [];
    private Dictionary<string, string> _hostNames = new(); // game clan tag -> clan name, for this clan's rosters
    private SubRoster? _hostedRoster;                      // the roster another clan plays in this clan, if any
    private string _hostedOwnerName = string.Empty;

    private IReadOnlyList<DiscordRole> _roles = [];
    private IReadOnlyList<DiscordChannel> _channels = [];
    private Dictionary<ulong, string> _roleNames = new();
    private Dictionary<ulong, string> _channelNames = new();
    private bool _guildLoaded;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        if (!user.IsInRole(AuthRoles.Gatekeeper))
            return; // <AuthorizeView> already blocks the UI; just don't load data.

        _actor = $"{user.Identity?.Name ?? "unknown"} ({user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "?"})";
        _clanName = await ClanNames.GetNameOrTagAsync(ClanTag);

        await LoadGuildAsync();
        await LoadSettingsAsync();
        await LoadRostersAsync();
    }

    // The rosters this clan owns, and the one another clan plays here. Both constrain the clan type,
    // so they're loaded before it can be edited — see <see cref="TypeError"/>.
    private async Task LoadRostersAsync()
    {
        _ownRosters = await SubRosters.GetForClanAsync(ClanTag);
        _hostNames = new Dictionary<string, string>();
        foreach (var sr in _ownRosters)
            _hostNames[sr.GameClanTag] = await ClanNames.GetNameOrTagAsync(sr.GameClanTag);

        _hostedRoster = await SubRosters.GetHostedAsync(ClanTag);
        _hostedOwnerName = _hostedRoster is null
            ? string.Empty
            : await ClanNames.GetNameOrTagAsync(_hostedRoster.ClanTag);
    }

    /// <summary>
    /// Why the picked clan type can't be saved, or null when it's fine. Rosters are only rule-checked
    /// when they're created (SubRosterRules), so the type they depend on has to be held to the same
    /// rules here — otherwise a type change quietly breaks a roster that already exists.
    /// </summary>
    private string? TypeError
    {
        get
        {
            if (_settings is null)
                return null;

            if (_hostedRoster is not null && !SubRosterRules.CanHost(_settings.ClanType))
                return $"{_hostedOwnerName} plays its \"{_hostedRoster.Name}\" roster in this clan, and only "
                    + "event or partner clans can host one. Delete that roster first.";

            if (_ownRosters.Count > 0 && !RosterTabs.HasRoster(_settings.ClanType))
                return $"This clan owns {_ownRosters.Count} extra roster{(_ownRosters.Count == 1 ? "" : "s")}, "
                    + "managed on its roster page — which event and partner clans don't have. Delete them first.";

            return null;
        }
    }

    private async Task LoadSettingsAsync()
    {
        _settings = await Settings.GetAsync(ClanTag);
        _exists = await Settings.ExistsAsync(ClanTag);
    }

    private async Task LoadGuildAsync(bool forceRefresh = false)
    {
        _roles = await Guild.GetRolesAsync(forceRefresh);
        _channels = await Guild.GetTextChannelsAsync(forceRefresh);
        _roleNames = _roles.ToDictionary(r => r.Id, r => r.Name);
        _channelNames = _channels.ToDictionary(c => c.Id, c => c.Display);
        _guildLoaded = _roles.Count > 0 || _channels.Count > 0;
    }

    private async Task RefreshGuild()
    {
        _refreshing = true;
        try
        {
            await LoadGuildAsync(forceRefresh: true);
            Snackbar.Add(_guildLoaded ? "Refreshed roles & channels." : "Still couldn't reach Discord.",
                _guildLoaded ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_settings is null)
            return;

        if (!ClanSettingsService.IsValidColorHex(_settings.ColorHex))
        {
            Snackbar.Add("Fix the colour before saving.", Severity.Error);
            return;
        }

        if (TypeError is not null)
        {
            Snackbar.Add(TypeError, Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            await Settings.SaveAsync(_settings);
            _exists = true;
            Logger.LogInformation("{Actor} saved settings for {Clan} ({Tag}): {Summary}",
                _actor, _clanName, ClanTag, Summarize(_settings));
            Snackbar.Add("Settings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{Actor} failed to save settings for {Clan} ({Tag})", _actor, _clanName, ClanTag);
            Snackbar.Add($"Couldn't save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset clan settings",
            $"Delete all saved settings for {_clanName}? The clan will fall back to bot defaults. "
            + RosterResetWarning()
            + "This can't be undone.",
            yesText: "Reset", cancelText: "Cancel");
        if (confirmed != true)
            return;

        _saving = true;
        try
        {
            var removed = await Settings.ResetAsync(ClanTag);
            if (removed)
            {
                Logger.LogInformation("{Actor} reset (deleted) settings for {Clan} ({Tag})", _actor, _clanName, ClanTag);
                Snackbar.Add("Settings reset to defaults.", Severity.Success);
            }
            await LoadSettingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{Actor} failed to reset settings for {Clan} ({Tag})", _actor, _clanName, ClanTag);
            Snackbar.Add($"Couldn't reset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // Concise, log-friendly one-liner of the persisted values (ids resolved to names where known).
    private string Summarize(ClanSettingsEntity s) =>
        $"type={s.ClanType}, order={s.Order}, color={s.ColorHex ?? "-"}, "
        + $"member={RoleName(s.MemberRoleId)}, elder={RoleName(s.ElderRoleId)}, leader={RoleName(s.LeaderRoleId)}, cwl={RoleName(s.CwlRoleId)}, "
        + $"signup={s.EnableCwlSignup}, champStyle={s.ChampStyleCwlRoster}, mainRosterSize={s.CwlRosterTargetSize}, "
        + $"ccGoldDump={s.CcGoldDump}, "
        + $"leadershipChannel={ChannelName(s.LeadershipChannelId)}, "
        + $"cwlRosterReminder={s.CwlRosterReminderEnabled} "
        + $"(ping={RoleName(s.CwlRosterReminderPingRoleId)}, lead={s.CwlRosterReminderLeadHours}h), "
        + $"warSpinReminder={s.WarSpinReminderEnabled}";

    // Resetting drops the clan type, which is what the roster rules hang off — say so before it happens.
    private string RosterResetWarning()
    {
        if (_ownRosters.Count > 0)
            return $"Its {_ownRosters.Count} extra roster{(_ownRosters.Count == 1 ? "" : "s")} and their players "
                + "stay, but the main roster falls back to 15v15. ";

        if (_hostedRoster is not null)
            return $"{_hostedOwnerName}'s \"{_hostedRoster.Name}\" keeps playing here, but this clan stops "
                + "counting as an event or partner clan. ";

        return string.Empty;
    }

    private static string WarSize(int size) => $"{size}v{size}";

    private string HostName(string gameClanTag) =>
        _hostNames.TryGetValue(gameClanTag, out var name) ? name : gameClanTag;

    private static string RosterHref(string clanTag, int? subRosterId) =>
        subRosterId is null
            ? $"/clans/{Uri.EscapeDataString(clanTag)}/roster"
            : $"/clans/{Uri.EscapeDataString(clanTag)}/roster/{subRosterId}";

    private string RoleName(ulong? id) =>
        id is null ? "-" : _roleNames.TryGetValue(id.Value, out var n) ? $"@{n}" : id.Value.ToString();

    private string ChannelName(ulong? id) =>
        id is null ? "-" : _channelNames.TryGetValue(id.Value, out var n) ? n : id.Value.ToString();

    private static string Swatch(string? colorHex) =>
        $"display:inline-block;width:1.1em;height:1.1em;border-radius:3px;border:1px solid var(--mud-palette-lines-default);"
        + $"background:{(string.IsNullOrWhiteSpace(colorHex) ? "transparent" : colorHex)};";

    // Searchable role picker. Bound to the id, but the autocomplete works over DiscordRole so it can
    // filter by name and show a colour swatch per item.
    private RenderFragment RoleSelect(string label, ulong? value, Action<ulong?> setter) =>
        @<MudAutocomplete T="DiscordRole" Label="@label" Value="RoleFor(value)" ValueChanged="r => setter(r?.Id)"
                          SearchFunc="SearchRoles" ToStringFunc="@(r => r?.Name ?? string.Empty)"
                          Clearable="true" ResetValueOnEmptyText="true" CoerceText="true"
                          Dense="true" Class="mb-2" MaxItems="null">
            <ItemTemplate Context="r">
                <div class="d-flex align-center"><span style="@Swatch(r.ColorHex)"></span>&nbsp;@r.Name</div>
            </ItemTemplate>
        </MudAutocomplete>;

    // Searchable text-channel picker, filtering by the "Category / #channel" display string.
    private RenderFragment ChannelSelect(string label, ulong? value, Action<ulong?> setter) =>
        @<MudAutocomplete T="DiscordChannel" Label="@label" Value="ChannelFor(value)" ValueChanged="c => setter(c?.Id)"
                          SearchFunc="SearchChannels" ToStringFunc="@(c => c?.Display ?? string.Empty)"
                          Clearable="true" ResetValueOnEmptyText="true" CoerceText="true"
                          Dense="true" Class="mb-2" MaxItems="null" />;

    // Resolve an id back to its item for the autocomplete's Value. A saved-but-now-unknown id (e.g. the
    // role/channel was deleted, or Discord failed to load) still shows as a synthetic "unknown" entry
    // rather than a misleading blank field.
    private DiscordRole? RoleFor(ulong? id) => id is null
        ? null
        : _roles.FirstOrDefault(r => r.Id == id.Value) ?? new DiscordRole(id.Value, $"Unknown role ({id})", 0, 0);

    private DiscordChannel? ChannelFor(ulong? id) => id is null
        ? null
        : _channels.FirstOrDefault(c => c.Id == id.Value) ?? new DiscordChannel(id.Value, $"unknown ({id})", null, 0);

    private Task<IEnumerable<DiscordRole>> SearchRoles(string? text, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? _roles.AsEnumerable()
            : _roles.Where(r => r.Name.Contains(text, StringComparison.OrdinalIgnoreCase)));

    private Task<IEnumerable<DiscordChannel>> SearchChannels(string? text, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? _channels.AsEnumerable()
            : _channels.Where(c => c.Display.Contains(text, StringComparison.OrdinalIgnoreCase)));
}
