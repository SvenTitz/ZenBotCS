@page "/clans/{ClanTag}"
@page "/clans/{ClanTag}/roster"
@page "/clans/{ClanTag}/roster/{SubRosterId:int}"
@page "/roster/{ClanTag}"
@using System.Security.Claims
@inject RosterService Rosters
@inject SubRosterService SubRosters
@inject NavigationManager Nav
@inject ClanNameService ClanNames
@inject PlayerSuggestionService PlayerSuggestions
@inject RosterImageService RosterImage
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ILogger<Roster> Logger

<PageTitle>Roster @_clanName</PageTitle>

<ClanTabs ClanTag="@ClanTag" Active="roster" />

<AuthorizeView Roles="@AuthRoles.RosterAccess" Context="auth">
    <NotAuthorized>
        @if (auth.User.Identity?.IsAuthenticated == true)
        {
            <MudAlert Severity="Severity.Warning">
                Signed in as <b>@auth.User.Identity.Name</b>, but your account doesn't have roster access.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                Please <MudLink Href="/account/login">sign in with Discord</MudLink> to view this roster.
            </MudAlert>
        }
    </NotAuthorized>
    <Authorized>
        @* Roster switcher. Only shown once the clan actually has a second roster, so a clan that
           never splits its signups sees the page exactly as before. *@
        @if (_subRosters.Count > 0)
        {
            <div class="d-flex flex-wrap align-center gap-1 mb-3" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                @RosterTab(null, "Main roster", ClanTag)
                @foreach (var sr in _subRosters)
                {
                    @RosterTab(sr.Id, sr.Name, sr.GameClanTag)
                }
                <MudTooltip Text="New roster">
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="OpenCreate" aria-label="New roster" />
                </MudTooltip>
            </div>
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.h5">@_rosterTitle</MudText>
                <MudText Typo="Typo.caption" Style="font-family:monospace;">@_rosterSubtitle</MudText>
            </div>
            <MudSpacer />
            @if (_subRosters.Count == 0)
            {
                <MudButton OnClick="OpenCreate" StartIcon="@Icons.Material.Filled.CallSplit"
                           Variant="Variant.Text" Size="Size.Small" Class="mr-2">
                    Split roster
                </MudButton>
            }
            else if (_rosterId is not null)
            {
                <MudMenu Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Dense="true"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-2">
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="OpenRename">Rename roster…</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.DeleteOutline" OnClick="DeleteRoster">Delete roster…</MudMenuItem>
                </MudMenu>
            }
            <MudButton OnClick="OpenAdd" StartIcon="@Icons.Material.Filled.PersonAdd"
                       Variant="Variant.Outlined" Size="Size.Small" Class="mr-2">
                Add player
            </MudButton>
            @if (_subRosters.Count > 0)
            {
                <MudButton OnClick="ToggleSelectMode" StartIcon="@Icons.Material.Filled.Checklist"
                           Variant="@(_selectMode ? Variant.Filled : Variant.Outlined)"
                           Color="@(_selectMode ? Color.Primary : Color.Default)"
                           Size="Size.Small" Class="mr-2"
                           Disabled="@(_signups is null || _signups.Count == 0)">
                    @(_selectMode ? "Done" : "Select")
                </MudButton>
            }
            <MudButton OnClick="SolveRoster" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                       Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mr-2"
                       Disabled="@(_signups is null || _signups.Count == 0 || _solving)">
                Solve roster
            </MudButton>
            <MudButton OnClick="DownloadImage" StartIcon="@Icons.Material.Filled.Download"
                       Variant="Variant.Outlined" Size="Size.Small" Class="mr-2"
                       Disabled="@(_signups is null || _signups.Count == 0)">
                Download image
            </MudButton>
            @if (_hidden is { Count: > 0 })
            {
                <MudButton OnClick="@(() => _showHidden = !_showHidden)" StartIcon="@Icons.Material.Filled.VisibilityOff"
                           Variant="Variant.Text" Size="Size.Small" Class="mr-2">
                    @(_showHidden ? "Hide hidden" : $"Show hidden ({_hidden.Count})")
                </MudButton>
            }
            <div>
                <MudText Typo="Typo.caption" Class="d-block">War size</MudText>
                <MudToggleGroup T="int" Value="_targetSize" ValueChanged="OnTargetSizeChanged" Size="Size.Small" Color="Color.Primary">
                    <MudToggleItem Value="15">15v15</MudToggleItem>
                    <MudToggleItem Value="30">30v30</MudToggleItem>
                </MudToggleGroup>
            </div>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Tick the days each player should play. Defaults to their declared availability; changes save automatically.
        </MudText>

        @if (_signups is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_signups.Count == 0)
        {
            <MudText>No active signups for this clan.</MudText>
        }
        else
        {
            @if (_selectMode)
            {
                <MudPaper Outlined="true" Class="pa-2 mb-2 d-flex flex-wrap align-center gap-2">
                    <MudCheckBox T="bool?" Dense="true" Color="Color.Primary"
                                 Value="AllSelectedState" ValueChanged="OnSelectAllChanged" />
                    <MudText Typo="Typo.body2">
                        @(_selected.Count == 0 ? "Select players to move" : $"{_selected.Count} selected")
                    </MudText>
                    <MudSpacer />
                    <MudMenu Label="Move to…" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true"
                             Disabled="@(_selected.Count == 0 || _movingBulk)"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        @if (_rosterId is not null)
                        {
                            <MudMenuItem OnClick="@(() => MoveSelectedTo(null, "Main roster"))">Main roster</MudMenuItem>
                        }
                        @foreach (var sr in _subRosters.Where(sr => sr.Id != _rosterId))
                        {
                            var target = sr;
                            <MudMenuItem OnClick="@(() => MoveSelectedTo(target.Id, target.Name))">@target.Name</MudMenuItem>
                        }
                    </MudMenu>
                </MudPaper>
            }

            <div class="roster-scroll" @ref="_scrollContainer">
                <MudTable Items="_signups" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh Class="sticky-col">Player</MudTh>
                        <MudTh>Tag</MudTh>
                        <MudTh Style="text-align:center">TH</MudTh>
                        @if (_champStyle)
                        {
                            <MudTh Style="text-align:center">Max&nbsp;Def</MudTh>
                        }
                        @for (var d = 1; d <= 7; d++)
                        {
                            var dayNum = d;
                            var flag = DayFlags[d - 1];
                            var count = DayCount(flag);
                            <MudTh Style="text-align:center">
                                D@(dayNum)<br />
                                <MudText Inline="true" Typo="Typo.body2" Color="@CountColor(count)"><b>@count</b></MudText>
                            </MudTh>
                        }
                        <MudTh Style="text-align:center">Bonus</MudTh>
                        <MudTh Class="sticky-col-right" Style="text-align:center">
                            <span class="wp-abbr">WP</span><span class="wp-full">War pref</span>
                        </MudTh>
                        <MudTh Class="sticky-col-days" Style="text-align:center" title="Days rostered">#</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Player" Class="sticky-col">
            @* In selection mode the checkbox takes the row menu's place rather than adding a column,
               so the pinned Player column keeps its width and mobile is unaffected. *@
                            <div style="display:flex;align-items:center;gap:2px;">
                                @if (_selectMode)
                                {
                                    <MudCheckBox T="bool" Dense="true" Color="Color.Primary"
                                                 Value="@_selected.Contains(context.Id)"
                                                 ValueChanged="@(v => OnRowSelected(context, v))" />
                                }
                                else
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                                        @if (_subRosters.Count > 0)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.SwapVert" OnClick="@(() => OpenRowMove(context))">Move to roster…</MudMenuItem>
                                        }
                                        <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="@(() => OpenMove(context))">Move to clan…</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.VisibilityOff" OnClick="@(() => HidePlayer(context))">Hide</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => RemovePlayer(context))">Remove</MudMenuItem>
                                    </MudMenu>
                                }
                                <span>@context.PlayerName</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Tag" Style="font-family:monospace;">@context.PlayerTag</MudTd>
                        <MudTd DataLabel="TH" Style="text-align:center">@context.PlayerThLevel</MudTd>
                        @if (_champStyle)
                        {
                            <MudTd DataLabel="Max Def" Style="text-align:center">@(context.MaxDefeneses ? "Yes" : "No")</MudTd>
                        }
                        @foreach (var day in DayFlags)
                        {
                            var available = IsAvailable(context, day);
                            var playing = context.EffectiveRosterDays.HasFlag(day);
                            <MudTd Style="@DayCellStyle(available, playing)">
                                <MudTooltip Text="@(available ? null : "Player opted out of this day")" Disabled="available">
                                    <MudCheckBox T="bool" Dense="true" Color="Color.Success"
                                                 Value="playing"
                                                 ValueChanged="@(v => OnDayToggled(context, day, v))" />
                                </MudTooltip>
                            </MudTd>
                        }
                        <MudTd DataLabel="Bonus" Style="text-align:center">@(context.Bonus ? "Yes" : "No")</MudTd>
                        <MudTd DataLabel="War pref" Class="sticky-col-right" Style="text-align:center">
                            <span class="wp-abbr" title="@context.WarPreference">@WarPrefAbbr(context.WarPreference)</span><span class="wp-full">@context.WarPreference</span>
                        </MudTd>
                        <MudTd Class="sticky-col-days" Style="text-align:center">@PlayingDayCount(context)</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
            <MudText Typo="Typo.caption" Class="mt-2 d-block mud-text-secondary">
                <span style="@SwatchStyle(ColPlaying)"></span> playing &nbsp;
                <span style="@SwatchStyle(ColBenched)"></span> benched by leadership &nbsp;
                <span style="@SwatchStyle(ColOptedOut)"></span> player opted out &nbsp;
                <span style="@SwatchStyle(ColOverride)"></span> opted out but rostered &nbsp;—&nbsp;
                the number under each day is how many are rostered (green = matches @_targetSize).
            </MudText>
        }

        @if (_showHidden && _hidden is { Count: > 0 })
        {
            <MudPaper Outlined="true" Class="pa-3 mt-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Hidden players</MudText>
                @foreach (var h in _hidden)
                {
                    <div style="display:flex;align-items:center;gap:8px;" class="mb-1">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       Title="Unhide" OnClick="@(() => UnhidePlayer(h))" />
                        <span>@h.PlayerName</span>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">TH@(h.PlayerThLevel) · @h.PlayerTag</MudText>
                    </div>
                }
            </MudPaper>
        }

        <MudDialog @bind-Visible="_addOpen" Options="_dialogOptions">
            <TitleContent>Add player</TitleContent>
            <DialogContent>
                @* CoerceText=false so a pasted/typed tag that matches no suggestion is kept (not wiped
                   back to the null selection on blur) — that's how you add a player who isn't listed. *@
                <MudAutocomplete T="PlayerSuggestion" Label="Player" Placeholder="Start typing a name…"
                                 SearchFunc="SearchPlayers" ToStringFunc="@(p => p?.Label)"
                                 @bind-Value="_addPlayer" @bind-Text="_addTag"
                                 Immediate="true" Clearable="true" ResetValueOnEmptyText="true"
                                 CoerceText="false" MaxItems="25" Class="mb-3" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    Pick a player, or type an exact tag for someone not listed.
                </MudText>
                <MudSelect T="WarPreference" @bind-Value="_addPref" Label="War preference" Class="mb-3">
                    @foreach (var p in Enum.GetValues<WarPreference>())
                    {
                        <MudSelectItem Value="p">@p</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="_addBonus" Label="Bonus" Color="Color.Primary" />
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _addOpen = false)" Disabled="_adding">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAdd" Disabled="_adding">
                    @(_adding ? "Adding…" : "Add")
                </MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="_moveOpen" Options="_dialogOptions">
            <TitleContent>Move @_moveTarget?.PlayerName</TitleContent>
            <DialogContent>
                @if (_moveClans.Count == 0)
                {
                    <MudText Typo="Typo.body2">No other clans to move to.</MudText>
                }
                else
                {
                    <MudSelect T="string" @bind-Value="_moveClanTag" Label="Destination clan">
                        @foreach (var c in _moveClans)
                        {
                            <MudSelectItem Value="c.Tag">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _moveOpen = false)" Disabled="_moving">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitMove"
                           Disabled="@(_moving || string.IsNullOrEmpty(_moveClanTag))">Move</MudButton>
            </DialogActions>
        </MudDialog>
        <MudDialog @bind-Visible="_createOpen" Options="_dialogOptions">
            <TitleContent>New roster</TitleContent>
            <DialogContent>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Splits this clan's signups. The new roster plays its CWL in another clan, so pick
                    where it plays — players will need to move to that clan before the spin.
                </MudText>
                <MudTextField T="string" @bind-Value="_createName" Label="Roster name" Placeholder="B Roster" Class="mb-3" />
                @if (_hostClans.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        No clan is free to host a roster. Add an event or partner clan in the bot first —
                        a clan can only host one roster, and war clans run their own CWL.
                    </MudAlert>
                }
                else
                {
                    <MudSelect T="string" @bind-Value="_createHostTag" Label="Plays in" Class="mb-3">
                        @foreach (var c in _hostClans)
                        {
                            <MudSelectItem Value="c.Tag">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudText Typo="Typo.caption" Class="d-block mb-1">War size</MudText>
                <MudToggleGroup T="int" @bind-Value="_createSize" Size="Size.Small" Color="Color.Primary">
                    <MudToggleItem Value="15">15v15</MudToggleItem>
                    <MudToggleItem Value="30">30v30</MudToggleItem>
                </MudToggleGroup>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _createOpen = false)" Disabled="_creating">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitCreate"
                           Disabled="@(_creating || string.IsNullOrEmpty(_createHostTag))">
                    @(_creating ? "Creating…" : "Create")
                </MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="_rowMoveOpen" Options="_dialogOptions">
            <TitleContent>Move @_rowMoveTarget?.PlayerName</TitleContent>
            <DialogContent>
                <MudSelect T="int?" @bind-Value="_rowMoveTargetRoster" Label="Destination roster">
                    @if (_rosterId is not null)
                    {
                        <MudSelectItem T="int?" Value="@((int?)null)">Main roster</MudSelectItem>
                    }
                    @foreach (var sr in _subRosters.Where(sr => sr.Id != _rosterId))
                    {
                        <MudSelectItem T="int?" Value="@((int?)sr.Id)">@sr.Name</MudSelectItem>
                    }
                </MudSelect>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _rowMoveOpen = false)">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitRowMove">Move</MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="_renameOpen" Options="_dialogOptions">
            <TitleContent>Rename roster</TitleContent>
            <DialogContent>
                <MudTextField T="string" @bind-Value="_renameName" Label="Roster name" />
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _renameOpen = false)">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitRename"
                           Disabled="@(string.IsNullOrWhiteSpace(_renameName))">Rename</MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
</AuthorizeView>

@code {
    private static readonly RosterDays[] DayFlags =
    [
        RosterDays.Day1, RosterDays.Day2, RosterDays.Day3, RosterDays.Day4,
        RosterDays.Day5, RosterDays.Day6, RosterDays.Day7
    ];

    [Parameter] public string ClanTag { get; set; } = string.Empty;

    /// <summary>Which of the clan's rosters is open. Null (no route segment) is the main roster.
    /// It lives in the route so a refresh or a shared link lands on the same roster.</summary>
    [Parameter] public int? SubRosterId { get; set; }

    /// <summary>The open roster after checking it still exists. Blazor owns <see cref="SubRosterId"/>
    /// and may write it back from the route, so everything else reads this instead.</summary>
    private int? _rosterId;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CwlSignup>? _signups;
    private bool _champStyle;
    private string _clanName = string.Empty;
    private int _targetSize = 15;
    private bool _solving;
    private string _actor = "unknown"; // "username (discordId)" of the signed-in leader, for the audit log
    private ElementReference _scrollContainer;
    private bool _stickyRightInit;

    private List<CwlSignup>? _hidden;
    private bool _showHidden;
    // Rosters
    private List<SubRoster> _subRosters = new();
    private RosterCounts _counts = new(0, new Dictionary<int, int>());
    private string _rosterTitle = string.Empty;
    private string _rosterSubtitle = string.Empty;
    private bool _createOpen;
    private bool _creating;
    private string _createName = string.Empty;
    private string? _createHostTag;
    private int _createSize = 15;
    private List<(string Tag, string Name)> _hostClans = new();
    private bool _renameOpen;
    private string _renameName = string.Empty;
    // Bulk selection
    private bool _selectMode;
    private readonly HashSet<int> _selected = new();
    private bool _movingBulk;
    // Single-row "move to roster" reuses the bulk path with one id.
    private bool _rowMoveOpen;
    private CwlSignup? _rowMoveTarget;
    private int? _rowMoveTargetRoster;
    // Add-player dialog
    private bool _addOpen;
    private bool _adding;
    private PlayerSuggestion? _addPlayer;   // picked from the suggestions
    private string _addTag = string.Empty;  // raw typed text, used when nothing is picked
    private WarPreference _addPref = WarPreference.Alternate;
    private bool _addBonus;
    // Move dialog
    private bool _moveOpen;
    private bool _moving;
    private CwlSignup? _moveTarget;
    private string? _moveClanTag;
    private List<(string Tag, string Name)> _moveClans = new();
    private static readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

    // Wire up the pinned right-most column's scroll watcher once the table has rendered.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_signups is { Count: > 0 } && !_stickyRightInit)
        {
            _stickyRightInit = true;
            try
            {
                await JS.InvokeVoidAsync("initRosterStickyRight", _scrollContainer);
            }
            catch (JSDisconnectedException) { /* circuit torn down mid-navigation — nothing to wire up */ }
            catch (JSException) { /* element already detached (fast tab switch) — safe to ignore */ }
        }
    }

    // Runs on every navigation, not just the first, so switching rosters via the tab strip reloads
    // the grid rather than leaving the previous roster's players on screen.
    protected override async Task OnParametersSetAsync()
    {
        _clanName = ClanTag;
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        if (!user.IsInRole(AuthRoles.RosterAccess))
            return;

        // Discord username + user id, recorded on every action in the audit log.
        _actor = $"{user.Identity?.Name ?? "unknown"} ({user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "?"})";

        _clanName = await ClanNames.GetNameOrTagAsync(ClanTag);
        _champStyle = await Rosters.IsChampStyleAsync(ClanTag);
        _subRosters = await SubRosters.GetForClanAsync(ClanTag);
        _counts = await SubRosters.GetCountsAsync(ClanTag);

        // A stale id in the URL (roster deleted in another tab) falls back to the main roster rather
        // than rendering an empty grid with no way back.
        _rosterId = _subRosters.Any(sr => sr.Id == SubRosterId) ? SubRosterId : null;

        await ApplyRosterIdentityAsync();
        _targetSize = await SubRosters.GetTargetSizeAsync(ClanTag, _rosterId);
        await ReloadAsync();
    }

    // Heading and subtitle: the main roster is the clan itself, a subroster is named and shows the
    // clan it plays in — that clan is what players have to move to, so it's never hidden away.
    private async Task ApplyRosterIdentityAsync()
    {
        var current = _subRosters.FirstOrDefault(sr => sr.Id == _rosterId);
        if (current is null)
        {
            _rosterTitle = _clanName;
            _rosterSubtitle = ClanTag;
            return;
        }

        var hostName = await ClanNames.GetNameOrTagAsync(current.GameClanTag);
        _rosterTitle = $"{_clanName} · {current.Name}";
        _rosterSubtitle = $"plays in {hostName} ({current.GameClanTag})";
    }

    private string RosterHref(int? subRosterId) =>
        subRosterId is null
            ? $"/clans/{Uri.EscapeDataString(ClanTag)}/roster"
            : $"/clans/{Uri.EscapeDataString(ClanTag)}/roster/{subRosterId}";

    private RenderFragment RosterTab(int? id, string label, string tagForTitle) =>
        @<MudButton Href="@RosterHref(id)"
                    Variant="Variant.Text"
                    Size="Size.Small"
                    title="@tagForTitle"
                    Color="@(id == _rosterId ? Color.Primary : Color.Inherit)"
                    Style="@(id == _rosterId
                        ? "border-bottom:2px solid var(--mud-palette-primary);border-radius:0"
                        : "border-radius:0")">
            @label
            <MudText Inline="true" Typo="Typo.caption" Class="ml-1 mud-text-secondary">@_counts.For(id)</MudText>
        </MudButton>;

    // RosterDays and OptOutDays share the same bit layout, so a day flag value maps directly.
    private static bool IsAvailable(CwlSignup s, RosterDays day) => ((int)s.OptOutDays & (int)day) == 0;

    private int DayCount(RosterDays day) => _signups?.Count(s => s.EffectiveRosterDays.HasFlag(day)) ?? 0;

    // Number of days a player is rostered (count of set day flags).
    private static int PlayingDayCount(CwlSignup s) => DayFlags.Count(d => s.EffectiveRosterDays.HasFlag(d));

    private static string WarPrefAbbr(WarPreference p) => p switch
    {
        WarPreference.FWA => "F",
        WarPreference.Alternate => "A",
        WarPreference.EightStars => "8",
        WarPreference.Always => "W",
        _ => "?"
    };

    private Color CountColor(int count) =>
        count == _targetSize ? Color.Success : count > _targetSize ? Color.Error : Color.Warning;

    // Reset to default availability and auto-solve over-capacity days, then persist the whole lineup.
    private async Task SolveRoster()
    {
        if (_signups is null || _signups.Count == 0)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Solve roster",
            $"This resets every player in {_rosterTitle} to their default availability and re-solves the "
            + $"{_targetSize}v{_targetSize} lineup from scratch — any manual day edits will be lost. Continue?",
            yesText: "Solve", cancelText: "Cancel");
        if (confirmed != true)
            return;

        _solving = true;
        try
        {
            RosterSolver.Solve(_signups, _targetSize);
            var values = _signups.ToDictionary(s => s.Id, s => s.EffectiveRosterDays);
            await Rosters.SetRosterDaysBulkAsync(values);
            Logger.LogInformation("{Actor} solved {Roster} ({Size}v{Size}, {Count} signups)",
                _actor, _rosterTitle, _targetSize, _targetSize, _signups.Count);
            Snackbar.Add("Roster solved and saved.", Severity.Success);
        }
        catch
        {
            // Resync the grid to the DB so it doesn't show an unsaved solved state.
            _signups = await Rosters.GetRosterAsync(ClanTag, _rosterId);
            Snackbar.Add("Couldn't save the solved roster. Please try again.", Severity.Error);
        }
        finally
        {
            _solving = false;
        }
    }

    private void OpenAdd()
    {
        _addPlayer = null;
        _addTag = string.Empty;
        _addPref = WarPreference.Alternate;
        _addBonus = false;
        _addOpen = true;
    }

    // Suggest cached players by name substring, exactly like the bot's PlayerTagAutocompleteHandler.
    private async Task<IEnumerable<PlayerSuggestion>> SearchPlayers(string value, CancellationToken ct)
        => await PlayerSuggestions.SearchAsync(value, ct);

    private async Task SubmitAdd()
    {
        // Prefer the picked suggestion's tag; fall back to whatever tag was typed for an unlisted player.
        var tag = _addPlayer?.Tag ?? _addTag;
        _adding = true;
        try
        {
            var result = await Rosters.AddSignupAsync(ClanTag, tag, _addPref, _addBonus, _rosterId);
            if (!result.Ok)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return; // keep the dialog open so they can correct the tag
            }
            _addOpen = false;
            Logger.LogInformation("{Actor} added {Player} ({Tag}) to {Roster} — pref {Pref}, bonus {Bonus}",
                _actor, result.PlayerName ?? tag, tag, _rosterTitle, _addPref, _addBonus);
            Snackbar.Add(result.Message, Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task OpenMove(CwlSignup signup)
    {
        _moveTarget = signup;
        _moveClanTag = null;
        var clans = await Rosters.GetSignupClansAsync();
        var options = new List<(string Tag, string Name)>();
        foreach (var c in clans.Where(c => c.ClanTag != ClanTag))
            options.Add((c.ClanTag, await ClanNames.GetNameOrTagAsync(c.ClanTag)));
        _moveClans = options;
        _moveOpen = true;
    }

    private async Task SubmitMove()
    {
        if (_moveTarget is null || string.IsNullOrEmpty(_moveClanTag))
            return;

        _moving = true;
        try
        {
            await Rosters.MoveSignupAsync(_moveTarget.Id, _moveClanTag);
            var destName = _moveClans.FirstOrDefault(c => c.Tag == _moveClanTag).Name ?? _moveClanTag;
            Logger.LogInformation("{Actor} moved {Player} ({Tag}) from {FromClan} to {ToClan}",
                _actor, _moveTarget.PlayerName, _moveTarget.PlayerTag, _clanName, destName);
            _moveOpen = false;
            Snackbar.Add($"Moved {_moveTarget.PlayerName}.", Severity.Success);
            await ReloadAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't move the player. Please try again.", Severity.Error);
        }
        finally
        {
            _moving = false;
        }
    }

    private async Task HidePlayer(CwlSignup signup) => await SetHidden(signup, true);

    private async Task UnhidePlayer(CwlSignup signup) => await SetHidden(signup, false);

    private async Task SetHidden(CwlSignup signup, bool hidden)
    {
        try
        {
            await Rosters.SetHiddenAsync(signup.Id, hidden);
            Logger.LogInformation("{Actor} {Action} {Player} ({Tag}) in {Clan}",
                _actor, hidden ? "hid" : "unhid", signup.PlayerName, signup.PlayerTag, _clanName);
            Snackbar.Add($"{(hidden ? "Hid" : "Unhid")} {signup.PlayerName}.", Severity.Success);
            await ReloadAsync();
        }
        catch
        {
            Snackbar.Add($"Couldn't {(hidden ? "hide" : "unhide")} the player. Please try again.", Severity.Error);
        }
    }

    private async Task RemovePlayer(CwlSignup signup)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove signup",
            $"Remove {signup.PlayerName} from the signups entirely? This can't be undone.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await Rosters.DeleteSignupAsync(signup.Id);
            Logger.LogInformation("{Actor} removed {Player} ({Tag}) from {Clan}",
                _actor, signup.PlayerName, signup.PlayerTag, _clanName);
            Snackbar.Add($"Removed {signup.PlayerName}.", Severity.Success);
            await ReloadAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't remove the player. Please try again.", Severity.Error);
        }
    }

    // Re-fetch both lists after any mutation so the grid, totals, and hidden section stay in sync.
    private async Task ReloadAsync()
    {
        _signups = await Rosters.GetRosterAsync(ClanTag, _rosterId);
        _hidden = await Rosters.GetHiddenAsync(ClanTag, _rosterId);
        _counts = await SubRosters.GetCountsAsync(ClanTag);
        // Ids that just left this roster must not stay selected and get moved again.
        _selected.RemoveWhere(id => _signups.All(s => s.Id != id));
        if (_hidden.Count == 0)
            _showHidden = false;
    }

    private async Task OnTargetSizeChanged(int size)
    {
        var previous = _targetSize;
        _targetSize = size; // optimistic — the day-count colours react immediately
        try
        {
            await SubRosters.SetTargetSizeAsync(ClanTag, _rosterId, size);
            Logger.LogInformation("{Actor} set the war size of {Roster} to {Size}v{Size}",
                _actor, _rosterTitle, size, size);
        }
        catch
        {
            _targetSize = previous;
            Snackbar.Add("Couldn't save the war size. Please try again.", Severity.Error);
        }
    }

    private void ToggleSelectMode()
    {
        _selectMode = !_selectMode;
        _selected.Clear(); // leaving selection mode discards the selection rather than hiding it
    }

    private void OnRowSelected(CwlSignup signup, bool selected)
    {
        if (selected)
            _selected.Add(signup.Id);
        else
            _selected.Remove(signup.Id);
    }

    // Tri-state header checkbox: null renders as indeterminate for a partial selection.
    private bool? AllSelectedState
    {
        get
        {
            if (_signups is null || _signups.Count == 0 || _selected.Count == 0)
                return false;
            return _selected.Count == _signups.Count ? true : null;
        }
    }

    private void OnSelectAllChanged(bool? value)
    {
        _selected.Clear();
        if (value == true && _signups is not null)
            foreach (var s in _signups)
                _selected.Add(s.Id);
    }

    private async Task MoveSelectedTo(int? subRosterId, string targetName)
    {
        if (_selected.Count == 0)
            return;

        var ids = _selected.ToList();
        var names = _signups?.Where(s => ids.Contains(s.Id)).Select(s => s.PlayerName).ToList() ?? [];

        _movingBulk = true;
        try
        {
            await Rosters.MoveToSubRosterAsync(ids, subRosterId);
            Logger.LogInformation("{Actor} moved {Count} player(s) from {FromRoster} to {ToRoster} in {Clan}: {Players}",
                _actor, ids.Count, _rosterTitle, targetName, _clanName, string.Join(", ", names));
            _selected.Clear();
            Snackbar.Add($"Moved {ids.Count} player(s) to {targetName}.", Severity.Success);
            await ReloadAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't move the players. Please try again.", Severity.Error);
        }
        finally
        {
            _movingBulk = false;
        }
    }

    private void OpenRowMove(CwlSignup signup)
    {
        _rowMoveTarget = signup;
        // Preselect the likeliest destination: back to the main roster from a subroster, or the first
        // other roster when we're already on the main one.
        _rowMoveTargetRoster = _rosterId is null
            ? _subRosters.FirstOrDefault()?.Id
            : null;
        _rowMoveOpen = true;
    }

    private async Task SubmitRowMove()
    {
        if (_rowMoveTarget is null)
            return;

        var targetName = _rowMoveTargetRoster is null
            ? "Main roster"
            : _subRosters.FirstOrDefault(sr => sr.Id == _rowMoveTargetRoster)?.Name ?? "another roster";

        try
        {
            await Rosters.MoveToSubRosterAsync([_rowMoveTarget.Id], _rowMoveTargetRoster);
            Logger.LogInformation("{Actor} moved {Player} ({Tag}) from {FromRoster} to {ToRoster} in {Clan}",
                _actor, _rowMoveTarget.PlayerName, _rowMoveTarget.PlayerTag, _rosterTitle, targetName, _clanName);
            _rowMoveOpen = false;
            Snackbar.Add($"Moved {_rowMoveTarget.PlayerName} to {targetName}.", Severity.Success);
            await ReloadAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't move the player. Please try again.", Severity.Error);
        }
    }

    private async Task OpenCreate()
    {
        _createName = _subRosters.Count == 0 ? "B Roster" : string.Empty;
        _createHostTag = null;
        _createSize = 15;
        var tags = await SubRosters.GetAvailableHostClanTagsAsync(ClanTag);
        var options = new List<(string Tag, string Name)>();
        foreach (var tag in tags)
            options.Add((tag, await ClanNames.GetNameOrTagAsync(tag)));
        _hostClans = options;
        _createOpen = true;
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrEmpty(_createHostTag))
            return;

        _creating = true;
        try
        {
            var result = await SubRosters.CreateAsync(ClanTag, _createHostTag, _createName, _createSize);
            if (!result.Ok)
            {
                Snackbar.Add(result.Error!, Severity.Error);
                return; // keep the dialog open so the choice can be corrected
            }

            var hostName = _hostClans.FirstOrDefault(c => c.Tag == _createHostTag).Name ?? _createHostTag;
            Logger.LogInformation("{Actor} created roster {Roster} for {Clan}, playing in {HostClan} ({Size}v{Size})",
                _actor, result.SubRoster!.Name, _clanName, hostName, _createSize, _createSize);
            _createOpen = false;
            Snackbar.Add($"Created {result.SubRoster.Name}.", Severity.Success);
            Nav.NavigateTo(RosterHref(result.SubRoster.Id));
        }
        catch
        {
            Snackbar.Add("Couldn't create the roster. Please try again.", Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }

    private void OpenRename()
    {
        _renameName = _subRosters.FirstOrDefault(sr => sr.Id == _rosterId)?.Name ?? string.Empty;
        _renameOpen = true;
    }

    private async Task SubmitRename()
    {
        if (_rosterId is null || string.IsNullOrWhiteSpace(_renameName))
            return;

        var previousName = _subRosters.FirstOrDefault(sr => sr.Id == _rosterId)?.Name;
        try
        {
            await SubRosters.RenameAsync(_rosterId.Value, _renameName);
            Logger.LogInformation("{Actor} renamed roster {OldName} to {NewName} in {Clan}",
                _actor, previousName, _renameName.Trim(), _clanName);
            _renameOpen = false;
            _subRosters = await SubRosters.GetForClanAsync(ClanTag);
            await ApplyRosterIdentityAsync();
            Snackbar.Add("Roster renamed.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Couldn't rename the roster. Please try again.", Severity.Error);
        }
    }

    private async Task DeleteRoster()
    {
        var current = _subRosters.FirstOrDefault(sr => sr.Id == _rosterId);
        if (current is null)
            return;

        var count = _signups?.Count ?? 0;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete {current.Name}",
            count == 0
                ? $"Delete {current.Name}? Nobody is in it."
                : $"Delete {current.Name}? Its {count} player(s) move back to the main roster — "
                  + "their signups and day lineups are kept.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await SubRosters.DeleteAsync(current.Id);
            Logger.LogInformation("{Actor} deleted roster {Roster} from {Clan}; {Count} player(s) returned to the main roster",
                _actor, current.Name, _clanName, count);
            Snackbar.Add($"Deleted {current.Name}.", Severity.Success);
            Nav.NavigateTo(RosterHref(null));
        }
        catch
        {
            Snackbar.Add("Couldn't delete the roster. Please try again.", Severity.Error);
        }
    }

    private async Task DownloadImage()
    {
        if (_signups is null || _signups.Count == 0)
            return;

        var bytes = RosterImage.Generate(_clanName, _signups, dark: true);
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"{_clanName}-cwl-roster.png".Replace(' ', '_');
        await JS.InvokeVoidAsync("downloadFile", fileName, "image/png", base64);
    }

    // Day-cell colours. Kept as constants so the table and the legend stay in sync.
    private const string ColPlaying = "rgba(56,142,60,0.32)";   // green — rostered, player was available
    private const string ColBenched = "rgba(251,192,45,0.25)";  // yellow — available, but benched by leadership
    private const string ColOptedOut = "rgba(211,47,47,0.25)";  // red — the player opted out themselves
    // green/red caution stripes — rostered despite the player opting out (leadership override).
    // Stripe alphas match the solid green/red above (0.32 / 0.25).
    private const string ColOverride =
        "repeating-linear-gradient(45deg,rgba(56,142,60,0.32) 0,rgba(56,142,60,0.32) 7px,rgba(211,47,47,0.25) 7px,rgba(211,47,47,0.25) 14px)";

    private static string DayCellStyle(bool available, bool playing)
    {
        string bg = playing
            ? (available ? ColPlaying : ColOverride)   // rostered; striped if the player had opted out
            : (available ? ColBenched : ColOptedOut);  // not rostered; red if the player opted out
        return $"text-align:center;background:{bg}";
    }

    private static string SwatchStyle(string bg) =>
        $"display:inline-block;width:0.9em;height:0.9em;vertical-align:middle;border-radius:2px;background:{bg};";

    private async Task OnDayToggled(CwlSignup signup, RosterDays day, bool playing)
    {
        var previous = signup.RosterDays;
        var current = signup.EffectiveRosterDays;
        signup.RosterDays = playing ? current | day : current & ~day; // optimistic

        try
        {
            await Rosters.SetRosterDaysAsync(signup.Id, signup.RosterDays.Value);
            Logger.LogInformation("{Actor} set {Player} ({Tag}) {Direction} {Day} in {Clan}",
                _actor, signup.PlayerName, signup.PlayerTag, playing ? "IN" : "OUT", day, _clanName);
        }
        catch
        {
            signup.RosterDays = previous; // revert on failure
            Snackbar.Add($"Couldn't save the change for {signup.PlayerName}. Please try again.", Severity.Error);
        }
    }
}
